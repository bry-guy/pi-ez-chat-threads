{
  "name": "pi-ez-chat-threads",
  "version": "0.6.0",
  "description": "Create persistent Discord thread-backed pi-chat sessions from the current pi-chat context.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bry-guy/pi-ez-chat-threads.git"
  },
  "homepage": "https://github.com/bry-guy/pi-ez-chat-threads#readme",
  "bugs": {
    "url": "https://github.com/bry-guy/pi-ez-chat-threads/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-chat",
    "discord",
    "threads",
    "handoff"
  ],
  "license": "MIT",
  "author": "bry-guy",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx test.ts",
    "validate": "npm run typecheck && npm test",
    "check": "npm run validate"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.75.4",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "pi-ez-lib": "https://github.com/bry-guy/pi-ez-lib/archive/refs/tags/v0.1.4.tar.gz"
  }
}
